# Copy to .env and adjust. docker compose reads it automatically. All values are optional.

# Identity. Default: the org slot is read from the certificate in ./certs.
# GOAT_ORG=<your 32-hex slot id>
# Default: the "Router endpoint" in certs/NOTES.md. Required when the bundle has no NOTES.md.
# GOAT_ROUTER=tls/<router>:<port>
# Docker Desktop: the router name from NOTES.md and its mesh IP (nslookup <router> on the host).
# EFDI_ROUTER_HOST=<router>
# EFDI_ROUTER_IP=<mesh IP>

# How TAK devices get the picture: direct | multicast | server (docs/en/modes.md).
# multicast: also use docker-compose.multicast.yml (Linux). server: set TAK_SERVER below.
# TAK_MODE=direct
# server mode: 1 = keep the UDP/TCP outputs too (devices then get markers twice if also on the server).
# TAK_LOCAL_OUTPUTS=0
# multicast mode: IPv4 address of the LAN interface, if the machine has several networks.
# TAK_MULTICAST_IF=

# Name of this relay in the portal (heartbeat <org>/<system>/heartbeat/v1). Must be registered.
# GATEWAY_SYSTEM=tak-gateway

# Where CoT goes by UDP: host:port[,host:port]. Default port 6969; WinTAK listens on 4242.
# TAK_UDP_TARGETS=host.docker.internal:6969,host.docker.internal:4242

# 1 = publish friendly PLI from your TAK clients to the backbone (<org>/tak/pli/v1/<uid>).
# TAK_INGEST=0
# Only these device uids may publish (empty = TAK apps on this machine only; in Docker set it:
# packets from the host do not come from 127.0.0.1). TAK Server users are never published.
# TAK_INGEST_UIDS=ANDROID-abc123   (* = any device on the network)

# 1 = share markers and drawings made on those devices (every CoT marker, hostile ones too) to the
# backbone (<org>/tak/cot/v1/<uid>); deletions follow. Messages are never shared.
# TAK_SHARE_MARKERS=0

# Optional TAK Server link. Put the .p12 files in ./certs/tak/ (seen as /certs/tak/ in the container).
# TAK_SERVER=tak.example:8089
# TAK_SERVER_P12=/certs/tak/relay.p12
# TAK_SERVER_P12_PASSWORD=
# TAK_SERVER_TRUST_P12=/certs/tak/truststore-root.p12
# TAK_SERVER_VERIFY_HOSTNAME=1

# 1 = convert every recognised position format on the backbone; 0 = only */tak/cot/v1/**.
# GATEWAY_INGEST_ALL=1

# Video restream to TAK (RTSP). GATEWAY_VIDEO_HOST = the address TAK clients connect to.
# GATEWAY_VIDEO=0
# GATEWAY_VIDEO_HOST=127.0.0.1

# Edge-AI demo HTTP API bearer token (profile edge-api). Empty = no auth.
# EDGE_API_TOKEN=
